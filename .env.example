# System Environment Configuration
PROJECT_NAME="Intelligent Land Record Digitization and Validation System"
ENV="development"
DEBUG=True
API_V1_STR="/api"

# Security & JWT
JWT_SECRET_KEY="super-secret-land-record-jwt-token-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL for Prod, SQLite fallback for local dev)
DATABASE_URL="sqlite:///./land_records.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/land_records_db"

# Storage Configuration
STORAGE_DIR="./storage"

# AI / LLM Configuration
LLM_PROVIDER="gemini" # Options: 'gemini', 'openai', 'rule_based'
LLM_API_KEY=""        # Optional: Add your Gemini or OpenAI API key here. If blank, system runs robust rule-based extractor!
LLM_MODEL="gemini-1.5-flash"

# Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.60
